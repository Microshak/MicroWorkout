# Working notes (PRDs, session/resume logs, credentials doc) — local only
/docs/

# Godot
.godot/
*.translation

# Build artifacts
build/
*.apk
*.aab
*.pck
*.zip

# Signing / credentials — never commit
export_credentials.cfg
build/keystore.properties
*.keystore
*.jks
*.pem
*.p12
*.pfx
*.key
.env
.env.*
# tools/build_android.sh injects the keystore path/user/password into this file
# for the duration of a build — keep it local so a stray `git add` can't leak it.
export_presets.cfg

# Python tooling
__pycache__/
*.pyc
.venv/

# OS / editor
.DS_Store
Thumbs.db
*.swp
assets_src/
.test_tmp/

# Throwaway dev probes/runners (scripts/dev/ holds only real dev tools like build_themes.gd)
scripts/dev/_*.gd
scripts/dev/_*.gd.uid

# Throwaway dev probes + the generated compile-sweep scene
scenes/dev_compile_check.tscn
scenes/dev_*_probe.tscn
